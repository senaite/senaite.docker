<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="maitux.calcenhance">

  <genericsetup:registerProfile
      name="default"
      title="MAITUX Calculation Enhancement"
      description="Adds List and Calculated interim field types"
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="MAITUX Calculation Enhancement (uninstall)"
      description="Remove MAITUX Calculation Enhancement settings"
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

</configure>

