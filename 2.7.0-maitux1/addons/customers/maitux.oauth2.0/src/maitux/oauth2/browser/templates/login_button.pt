<tal:block xmlns:tal="http://xml.zope.org/namespaces/tal"
           xmlns:i18n="http://xml.zope.org/namespaces/i18n"
           omit-tag=""
           i18n:domain="maitux.oauth2">

  <!-- Only ever rendered in "hybrid mode", i.e. when 「/login 也直接跳转」 is
       switched off AND 「登录页显示统一登录按钮」 is switched on.  With the
       default configuration users never reach the local form at all, and the
       administrator bypass shows the local form on its own, so the two kinds
       of login are never offered side by side. -->

  <div style="max-width:32rem;margin:1.5rem auto 0;text-align:center">
    <a class="btn btn-primary btn-lg"
       style="min-width:16rem"
       tal:attributes="href view/login_url">竹云统一登录</a>
  </div>

</tal:block>
