<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="maitux.groupmanagement">

  <!-- Zope 2 包注册（皮肤层等基础机制需要） -->
  <include package="Products.Five" />
  <include package="Products.GenericSetup" file="meta.zcml" />
  <five:registerPackage package="." />

  <!-- 引入子包 ZCML 配置 -->
  <include package=".browser" />

  <!-- 隐藏卸载 Profile，保持 Add-ons 面板整洁 -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="maitux.groupmanagement"
      />

  <!-- 注册安装 Profile -->
  <genericsetup:registerProfile
      name="default"
      title="Maitux Group Management"
      directory="profiles/default"
      description="Standalone Group Management add-on (no Manager role, no group deletion)"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <!-- 标准安装入口：通过 importStep 调用 setup_handler -->
  <genericsetup:importStep
      name="maitux.groupmanagement.setuphandler"
      title="maitux.groupmanagement setup handler"
      description="Install Maitux Group Management registrations"
      handler="maitux.groupmanagement.setuphandlers.setup_handler">
    <depends name="plone-various"/>
  </genericsetup:importStep>

  <!-- 注册卸载 Profile -->
  <genericsetup:registerProfile
      name="uninstall"
      title="Uninstall Maitux Group Management"
      directory="profiles/uninstall"
      description="卸载 maitux.groupmanagement 包"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <!-- 标准卸载入口：通过 importStep 调用 uninstall_handler -->
  <genericsetup:importStep
      name="maitux.groupmanagement.uninstallhandler"
      title="maitux.groupmanagement uninstall handler"
      description="Uninstall Maitux Group Management registrations"
      handler="maitux.groupmanagement.setuphandlers.uninstall_handler">
    <depends name="plone-various"/>
  </genericsetup:importStep>

</configure>
