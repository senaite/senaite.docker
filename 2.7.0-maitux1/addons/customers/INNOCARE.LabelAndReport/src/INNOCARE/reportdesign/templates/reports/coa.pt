          </tr>
          <tr>
            <td class="m-label"><div class="zh">备注</div><div class="en">Comment</div></td>
            <td class="m-value" colspan="3" tal:content="comment"></td>
          </tr>
        </tbody>
      </table>

      <table class="analyses-table" cellspacing="0" cellpadding="0">
        <colgroup>
          <col class="acol-item" />
          <col class="acol-method" />
          <col class="acol-spec" />
          <col class="acol-result" />
        </colgroup>
        <thead>
          <tr>
            <th><div class="zh">检测项目</div><div class="en">Testing Item</div></th>
            <th><div class="zh">方法</div><div class="en">Method</div></th>
            <th><div class="zh">可接受标准</div><div class="en">Accept criteria</div></th>
            <th><div class="zh">结果</div><div class="en">Results</div></th>
          </tr>
        </thead>
        <tbody>
          <tal:rows repeat="row rows">
            <tal:group condition="python:row[0] == u'group'">
              <tr class="a-group-row">
                <td class="a-group" colspan="4">
                  <tal:bi condition="python:_BI_HAS(row[1])">
                    <div class="zh" tal:content="python:_BI_ZH(row[1])"></div>
                    <div class="en" tal:content="python:_BI_EN(row[1])"></div>
                  </tal:bi>
                  <tal:nobi condition="python:not _BI_HAS(row[1])">
                    <div tal:content="python:S(row[1], u'')"></div>
                  </tal:nobi>
                </td>
              </tr>
              <tal:child repeat="a python:row[2]">
                <tr tal:define="a_title    python: S(a.Title() if (hasattr(a,'Title') and callable(a.Title)) else getattr(a,'title',u''));
                                a_res_raw  python: (a.getFormattedResult() if (hasattr(a,'getFormattedResult') and callable(a.getFormattedResult)) else u'');
                                a_res2     python: (unicode(a.getResult()) if (hasattr(a,'getResult') and callable(a.getResult) and a.getResult() is not None) else u'');
                                a_res      python: (S(a_res_raw) or S(a_res2) or u'N/A');
                                a_unit_raw python: (a.getFormattedUnit() if (hasattr(a,'getFormattedUnit') and callable(a.getFormattedUnit)) else u'');
                                a_unit2    python: (unicode(a.getUnit()) if (hasattr(a,'getUnit') and callable(a.getUnit) and a.getUnit() is not None) else u'');
                                a_unit     python: (S(a_unit_raw) or S(a_unit2));
                                a_spec_raw python: (a.getFormattedSpecs() if (hasattr(a,'getFormattedSpecs') and callable(a.getFormattedSpecs)) else u'');
                                a_spec2    python: (unicode(a.getSpecification()) if (hasattr(a,'getSpecification') and callable(a.getSpecification) and a.getSpecification() is not None) else u'');
                                a_spec     python: (S(a_spec_raw) or S(a_spec2));
                                a_inst     python: (a.getInstrument() if (hasattr(a,'getInstrument') and callable(a.getInstrument)) else None);
                                a_method   python: (T(a_inst, u'\u2014') if a_inst is not None else u'\u2014');
                                a_unc      python: S(a.getFormattedUncertainty() if (hasattr(a,'getFormattedUncertainty') and callable(a.getFormattedUncertainty)) else u'');
                                unit_part  python: (u' ' + a_unit if S(a_unit) else u'');
                                unc_part   python: (u' +/- ' + a_unc if S(a_unc) else u'');
                                a_full     python: a_res + unit_part + unc_part;">
                  <td class="a-item" tal:content="a_title"></td>
                  <td class="a-method" tal:content="a_method"></td>
                  <td class="a-spec">
                    <tal:rep condition="python:_IS_REPORT(a_spec)">
                      <div class="zh">报告</div>
                      <div class="en">Report</div>
                    </tal:rep>
                    <tal:nrep condition="python:not _IS_REPORT(a_spec)">
                      <div tal:content="python:S(a_spec, u'N/A')"></div>
                    </tal:nrep>
                  </td>
                  <td class="a-result">
                    <tal:resbi condition="python:_BI_HAS(a_full)">
                      <div class="zh" tal:content="python:_BI_ZH(a_full)"></div>
                      <div class="en" tal:content="python:_BI_EN(a_full)"></div>
                    </tal:resbi>
                    <tal:resnobi condition="python:not _BI_HAS(a_full)">
                      <div tal:content="a_full"></div>
                    </tal:resnobi>
                  </td>
                </tr>
              </tal:child>
            </tal:group>
            <tal:single condition="python:row[0] == u'single'">
              <tr tal:define="a          python: row[1];
                              a_title    python: S(a.Title() if (hasattr(a,'Title') and callable(a.Title)) else getattr(a,'title',u''));
                              a_res_raw  python: (a.getFormattedResult() if (hasattr(a,'getFormattedResult') and callable(a.getFormattedResult)) else u'');
                              a_res2     python: (unicode(a.getResult()) if (hasattr(a,'getResult') and callable(a.getResult) and a.getResult() is not None) else u'');
                              a_res      python: (S(a_res_raw) or S(a_res2) or u'N/A');
                              a_unit_raw python: (a.getFormattedUnit() if (hasattr(a,'getFormattedUnit') and callable(a.getFormattedUnit)) else u'');
                              a_unit2    python: (unicode(a.getUnit()) if (hasattr(a,'getUnit') and callable(a.getUnit) and a.getUnit() is not None) else u'');
                              a_unit     python: (S(a_unit_raw) or S(a_unit2));
                              a_spec_raw python: (a.getFormattedSpecs() if (hasattr(a,'getFormattedSpecs') and callable(a.getFormattedSpecs)) else u'');
                              a_spec2    python: (unicode(a.getSpecification()) if (hasattr(a,'getSpecification') and callable(a.getSpecification) and a.getSpecification() is not None) else u'');
                              a_spec     python: (S(a_spec_raw) or S(a_spec2));
                              a_inst     python: (a.getInstrument() if (hasattr(a,'getInstrument') and callable(a.getInstrument)) else None);
                              a_method   python: (T(a_inst, u'\u2014') if a_inst is not None else u'\u2014');
                              a_unc      python: S(a.getFormattedUncertainty() if (hasattr(a,'getFormattedUncertainty') and callable(a.getFormattedUncertainty)) else u'');
                              unit_part  python: (u' ' + a_unit if S(a_unit) else u'');
                              unc_part   python: (u' +/- ' + a_unc if S(a_unc) else u'');
                              a_full     python: a_res + unit_part + unc_part;">
                <td class="a-item" tal:content="a_title"></td>
                <td class="a-method" tal:content="a_method"></td>
                <td class="a-spec">
                  <tal:rep condition="python:_IS_REPORT(a_spec)">
                    <div class="zh">报告</div>
                    <div class="en">Report</div>
                  </tal:rep>
                  <tal:nrep condition="python:not _IS_REPORT(a_spec)">
                    <div tal:content="python:S(a_spec, u'N/A')"></div>
                  </tal:nrep>
                </td>
                <td class="a-result">
                  <tal:resbi condition="python:_BI_HAS(a_full)">
                    <div class="zh" tal:content="python:_BI_ZH(a_full)"></div>
                    <div class="en" tal:content="python:_BI_EN(a_full)"></div>
                  </tal:resbi>
                  <tal:resnobi condition="python:not _BI_HAS(a_full)">
                    <div tal:content="a_full"></div>
                  </tal:resnobi>
                </td>
              </tr>
            </tal:single>
          </tal:rows>
          <tr tal:condition="python: (not analyses_pub) or len(analyses_pub) == 0">
            <td class="a-item" colspan="4" style="text-align:center;color:#999;padding:24px 0;">
              <div class="zh">无已发布检测项目</div>
              <div class="en">No analyses published</div>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="conclusion-block">
        <div>
          <span class="conclusion-label-zh">结论:</span>
          <span class="conclusion-label-en">Conclusion:</span>
        </div>
        <div class="conclusion-text">
          <tal:isref condition="is_reference_standard">
            <div tal:content="python:u'该批次样品质量合格，可作为 ' + material_name + u' 的对照品使用。'"></div>
            <div tal:content="python:u'The sample is qualified, can be used as standard for ' + material_name + u'.'"></div>
          </tal:isref>
          <tal:notref condition="python:not is_reference_standard">
            <div>该批次样品质量合格。</div>
            <div>The sample of this batch is qualified.</div>
          </tal:notref>
        </div>
      </div>

      <tal:ref condition="is_reference_standard">
        <div class="ref-block">
          <table class="ref-table" cellspacing="0" cellpadding="0">
            <colgroup>
              <col class="rcol-label" />
              <col class="rcol-value" />
            </colgroup>
            <tbody>
              <tr>
                <td class="r-label"><div class="zh">对照品赋值（%）</div><div class="en">Reference value</div></td>
                <td class="r-value" tal:content="reference_value2"></td>
              </tr>
            </tbody>
          </table>
        </div>
      </tal:ref>

    </div>
    <!-- END PAGE 1 -->

    <!-- PAGE 2 / PAGE 3 (Version history + signatures) -->
    <div class="coa-page coa-page-2">

      <div class="company-header company-header-mini">
        <div class="company-logo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 78"
               class="innocare-logo" xml:space="preserve" preserveAspectRatio="xMinYMid meet"
               width="220" height="60">
            <g transform="translate(0 0)">
              <circle cx="30" cy="39" r="7"  fill="#F5A623"/>
              <circle cx="14" cy="18" r="6"  fill="#F5A623"/>
              <circle cx="46" cy="18" r="6"  fill="#F5A623"/>
              <circle cx="50" cy="46" r="6"  fill="#F5A623"/>
              <circle cx="14" cy="52" r="6"  fill="#F5A623"/>
              <circle cx="32" cy="64" r="6"  fill="#F5A623"/>
              <circle cx="44" cy="31" r="4.5" fill="#F5A623"/>
              <path d="M23 44 L40 40" stroke="#F5A623" stroke-width="3" fill="none" stroke-linecap="round"/>
              <path d="M30 24 L32 56" stroke="#F5A623" stroke-width="3" fill="none" stroke-linecap="round"/>
              <g font-family="Arial, Helvetica, sans-serif" font-size="34" font-weight="bold" fill="#222222">
                <text x="70" y="50">INNOCARE</text>
              </g>
            </g>
          </svg>
        </div>
        <div class="company-info">
          <div class="company-name-zh">北京诺诚健华医药科技有限公司</div>
          <div class="company-name-en">Beijing InnoCarePharma Tech Co., Ltd</div>
        </div>
      </div>

      <div class="report-id-block">
        <span class="rid-label-zh">报告编号:</span>
        <span class="rid-label-en">Report ID</span>
        <span class="rid-value" tal:content="report_no"></span>
      </div>

      <table class="version-table" cellspacing="0" cellpadding="0">
        <colgroup>
          <col class="vcol-ver" />
          <col class="vcol-content" />
          <col class="vcol-date" />
        </colgroup>
        <thead>
          <tr>
            <th colspan="3">
              <div class="zh">版本历史</div>
              <div class="en">Version History</div>
            </th>
          </tr>
          <tr>
            <th><div class="zh">版本号</div><div class="en">Version</div></th>
            <th><div class="zh">修改内容</div><div class="en">Revised Content</div></th>
            <th><div class="zh">生效日期</div><div class="en">Effective Date</div></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="v-val" tal:content="coa_version"></td>
            <td class="v-val">
              <div class="zh">新建</div>
              <div class="en">Newly Establish</div>
            </td>
            <td class="v-val" tal:content="date_published"></td>
          </tr>
        </tbody>
      </table>

      <div class="sig-block">
        <div class="sig-row">
          <div class="sig-label-col">
            <div class="zh">起草人</div>
            <div class="en">Drafted By</div>
          </div>
          <div class="sig-value-col" tal:content="creator_fn"></div>
          <div class="sig-label-col">
            <div class="zh">日期</div>
            <div class="en">Date</div>
          </div>
          <div class="sig-value-col" tal:content="created_date"></div>
        </div>
        <div class="sig-row">
          <div class="sig-label-col">
            <div class="zh">审核人</div>
            <div class="en">Reviewed By</div>
          </div>
          <div class="sig-value-col" tal:content="verifier_name"></div>
          <div class="sig-label-col">
            <div class="zh">日期</div>
            <div class="en">Date</div>
          </div>
          <div class="sig-value-col" tal:content="date_published"></div>
        </div>
        <div class="sig-row">
          <div class="sig-label-col">
            <div class="zh">批准人</div>
            <div class="en">Approved by</div>
          </div>
          <div class="sig-value-col" tal:content="approver_name"></div>
          <div class="sig-label-col">
            <div class="zh">日期</div>
            <div class="en">Date</div>
          </div>
          <div class="sig-value-col">&nbsp;</div>
        </div>
      </div>

    </div>
    <!-- END PAGE 2/3 -->

    </div>

</tal:coa>
