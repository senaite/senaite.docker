            <td class="m-value" tal:content="manufacture_date"></td>
          </tr>
          <tr>
            <td class="m-label"><div class="zh">批号</div><div class="en">Batch Number</div></td>
            <td class="m-value" tal:content="batch_no"></td>
            <td class="m-label"><div class="zh">检测日期</div><div class="en">Test Date</div></td>
            <td class="m-value" tal:content="date_published"></td>
