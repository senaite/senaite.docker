        </tbody>
      </table>

      <table class="analyses-table" cellspacing="0" cellpadding="0">
        <colgroup>
          <col class="acol-item" />
          <col class="acol-method" />
          <col class="acol-spec" />
          <col class="acol-result" />
        </colgroup>
        <thead>
          <tr>
            <th><div class="zh">检测项目</div><div class="en">Testing Item</div></th>
            <th><div class="zh">方法</div><div class="en">Method</div></th>
            <th><div class="zh">可接受标准</div><div class="en">Accept criteria</div></th>
            <th><div class="zh">结果</div><div class="en">Results</div></th>
          </tr>
        </thead>
        <tbody>
          <tal:ana repeat="a analyses">
            <tr tal:define="a_title    python: S(a.Title() if (hasattr(a,'Title') and callable(a.Title)) else getattr(a,'title',u''));
                            a_res_raw  python: (a.getFormattedResult() if (hasattr(a,'getFormattedResult') and callable(a.getFormattedResult)) else u'');
                            a_res2     python: (unicode(a.getResult()) if (hasattr(a,'getResult') and callable(a.getResult) and a.getResult() is not None) else u'');
                            a_res      python: (S(a_res_raw) or S(a_res2) or u'N/A');
                            a_unit_raw python: (a.getFormattedUnit() if (hasattr(a,'getFormattedUnit') and callable(a.getFormattedUnit)) else u'');
                            a_unit2    python: (unicode(a.getUnit()) if (hasattr(a,'getUnit') and callable(a.getUnit) and a.getUnit() is not None) else u'');
                            a_unit     python: (S(a_unit_raw) or S(a_unit2));
                            a_spec_raw python: (a.getFormattedSpecs() if (hasattr(a,'getFormattedSpecs') and callable(a.getFormattedSpecs)) else u'');
                            a_spec2    python: (unicode(a.getSpecification()) if (hasattr(a,'getSpecification') and callable(a.getSpecification) and a.getSpecification() is not None) else u'');
                            a_spec     python: (S(a_spec_raw) or S(a_spec2) or u'Report');
                            a_inst     python: (a.getInstrument() if (hasattr(a,'getInstrument') and callable(a.getInstrument)) else None);
                            a_method   python: (T(a_inst, u'\u2014') if a_inst is not None else u'\u2014');
                            a_unc      python: S(a.getFormattedUncertainty() if (hasattr(a,'getFormattedUncertainty') and callable(a.getFormattedUncertainty)) else u'');
                            unit_part  python: (u' ' + a_unit if S(a_unit) else u'');
                            unc_part   python: (u' +/- ' + a_unc if S(a_unc) else u'');
                            a_full     python: a_res + unit_part + unc_part;">
              <td class="a-item" tal:content="a_title"></td>
              <td class="a-method" tal:content="a_method"></td>
              <td class="a-spec" tal:content="a_spec"></td>
              <td class="a-result" tal:content="a_full"></td>
            </tr>
          </tal:ana>
          <tr tal:condition="python: (not analyses) or len(analyses) == 0">
            <td class="a-item" colspan="4" style="text-align:center;color:#999;padding:24px 0;">No analyses published</td>
          </tr>
        </tbody>
      </table>

      <div class="conclusion-block">
