<tal:coa
  i18n:domain="INNOCARE.Reportdesign"
  tal:define="S                python:lambda v,d=u'': (d if (v is None or v==u'' or v=='') else (v if isinstance(v,unicode) else (v.decode('utf-8','ignore') if isinstance(v,str) else unicode(v))));
              T                python:lambda o,d=u'': (d if o is None else (lambda vv,dd=u'': (dd if (vv is None or vv==u'' or vv=='') else (vv if isinstance(vv,unicode) else (vv.decode('utf-8','ignore') if isinstance(vv,str) else unicode(vv)))))(((o.Title() if (hasattr(o,'Title') and callable(o.Title) and o.Title()) else getattr(o,'title',None)) if (hasattr(o,'Title') and callable(o.Title)) else getattr(o,'title',None)),d));
              FMTDT            python:lambda d,fmt,dflt=u'': (dflt if d is None else (unicode(d.strftime(fmt)) if (hasattr(d,'strftime') and callable(d.strftime)) else (lambda vv,dd=u'': (dd if (vv is None or vv==u'' or vv=='') else (vv if isinstance(vv,unicode) else (vv.decode('utf-8','ignore') if isinstance(vv,str) else unicode(vv)))))(d,dflt)));
              VG_NORM          python:lambda v: ([] if not v else (list(v) if isinstance(v,(list,tuple)) else ([v] if isinstance(v,(str,unicode)) and (v is not None and v!=u'' and v!='') else [])));
CTX              python:context;
              cmf_mod          python:__import__('Products.CMFCore.utils', fromlist=['getToolByName']);
              dt_mod_coa       python:__import__('DateTime');
              is_ar            python:(True if (hasattr(CTX,'getAnalyses') and callable(CTX.getAnalyses) and hasattr(CTX,'getClientReference') and callable(CTX.getClientReference)) else False);
              ar               python:(CTX if is_ar else None);
              portal           python:CTX.portal_url.getPortalObject();
              portal_url       python:portal.absolute_url();
              pm               python:cmf_mod.getToolByName(CTX, 'portal_membership');
              _empty           python:u'';

              ar_id_raw        python:((ar.getId() if (ar is not None and hasattr(ar,'getId') and callable(ar.getId)) else getattr(ar,'id',u'')) or u'') if ar else u'';
              ar_id            python:S(ar_id_raw, u'N/A');
              client_ref_raw   python:(((ar.getClientReference() if (ar is not None and hasattr(ar,'getClientReference') and callable(ar.getClientReference)) else u'') or ar_id) if ar else u'');
              client_ref       python:S(client_ref_raw, u'N/A');
              report_id        python:(client_ref or ar_id);
              schema           python:(ar.Schema() if (ar is not None and hasattr(ar,'Schema') and callable(ar.Schema)) else None);
              FLD              python:lambda fn: (schema.getField(fn) if (schema is not None and hasattr(schema,'getField') and callable(schema.getField)) else None);

              project_obj      python:((FLD('ProjectNo').getRaw(ar) if (FLD('ProjectNo') is not None and hasattr(FLD('ProjectNo'),'getRaw') and callable(FLD('ProjectNo').getRaw)) else None) if ar else None);
              project_gen      python:(T((ar.getProject() if (ar is not None and hasattr(ar,'getProject') and callable(ar.getProject)) else None), u'') if ar else u'');
              project_title    python:(((T(project_obj, u'') or project_gen) or u'N/A') if ar else u'N/A');
              compound_raw     python:((FLD('MaterialCode').getAccessor(ar)() if (FLD('MaterialCode') is not None and hasattr(FLD('MaterialCode'),'getAccessor') and callable(FLD('MaterialCode').getAccessor)) else (getattr(ar,'MaterialCode',u'') if (ar is not None and hasattr(ar,'MaterialCode')) else u'')) if ar else u'');
              compound_id      python:(S(compound_raw, u'') or ar_id);
              qty_raw          python:((FLD('Quantity').getAccessor(ar)() if (FLD('Quantity') is not None and hasattr(FLD('Quantity'),'getAccessor') and callable(FLD('Quantity').getAccessor)) else (getattr(ar,'Quantity',u'') if (ar is not None and hasattr(ar,'Quantity')) else u'')) if ar else u'');
              quantity         python:S(qty_raw);
              unit_raw         python:((FLD('Unit').getAccessor(ar)() if (FLD('Unit') is not None and hasattr(FLD('Unit'),'getAccessor') and callable(FLD('Unit').getAccessor)) else (getattr(ar,'Unit',u'') if (ar is not None and hasattr(ar,'Unit')) else u'')) if ar else u'');
              unit             python:S(unit_raw);
              qty_nempty       python:(True if S(quantity) not in (u'', None, '') else False);
              unit_nempty      python:(True if S(unit) not in (u'', None, '') else False);
              sampletype_t     python:(T((ar.getSampleType() if (ar is not None and hasattr(ar,'getSampleType') and callable(ar.getSampleType)) else None), u'') if ar else u'');
              date_recv_raw    python:((ar.getDateReceived() if (ar is not None and hasattr(ar,'getDateReceived') and callable(ar.getDateReceived)) else None) if ar else None);
              date_samp_raw    python:((ar.getDateSampled() if (ar is not None and hasattr(ar,'getDateSampled') and callable(ar.getDateSampled)) else None) if ar else None);
              batch_size       python:((S(quantity)+u' '+S(unit)) if (qty_nempty and unit_nempty) else (S(quantity) if qty_nempty else (S(unit) if unit_nempty else (sampletype_t or FMTDT(date_samp_raw, '%Y.%m.%d', u'N/A')))));
              material_raw     python:((FLD('MaterialName').getAccessor(ar)() if (FLD('MaterialName') is not None and hasattr(FLD('MaterialName'),'getAccessor') and callable(FLD('MaterialName').getAccessor)) else (getattr(ar,'MaterialName',u'') if (ar is not None and hasattr(ar,'MaterialName')) else u'')) if ar else u'');
              material_name    python:(S(material_raw, u'') or sampletype_t or u'N/A');
              mfg_raw          python:((FLD('ManufactureDate').getAccessor(ar)() if (FLD('ManufactureDate') is not None and hasattr(FLD('ManufactureDate'),'getAccessor') and callable(FLD('ManufactureDate').getAccessor)) else (getattr(ar,'ManufactureDate',None) if (ar is not None and hasattr(ar,'ManufactureDate')) else None)) if ar else None);
              manufacture_date python:(FMTDT(mfg_raw, '%Y.%m.%d', u'') or FMTDT(date_recv_raw, '%Y.%m.%d', u'') or FMTDT(date_samp_raw, '%Y.%m.%d', u'N/A'));
              batch_no         python:report_id;
              datepub_raw      python:((ar.getDatePublished() if (ar is not None and hasattr(ar,'getDatePublished') and callable(ar.getDatePublished)) else None) if ar else None);
              date_respub_raw  python:((ar.getDateResultPublished() if (ar is not None and hasattr(ar,'getDateResultPublished') and callable(ar.getDateResultPublished)) else None) if ar else None);
              date_published   python:(FMTDT(datepub_raw, '%Y.%m.%d', u'') or FMTDT(date_samp_raw, '%Y.%m.%d', u'') or FMTDT(date_recv_raw, '%Y.%m.%d', u'N/A'));
              str_raw          python:((FLD('Strength').getAccessor(ar)() if (FLD('Strength') is not None and hasattr(FLD('Strength'),'getAccessor') and callable(FLD('Strength').getAccessor)) else (getattr(ar,'Strength',u'') if (ar is not None and hasattr(ar,'Strength')) else u'')) if ar else u'');
              samplepoint_t    python:(T((ar.getSamplePoint() if (ar is not None and hasattr(ar,'getSamplePoint') and callable(ar.getSamplePoint)) else None), u'') if ar else u'');
              strength         python:(S(str_raw, u'') or samplepoint_t or u'N/A');
              ret_raw          python:((FLD('RetentionTime').getAccessor(ar)() if (FLD('RetentionTime') is not None and hasattr(FLD('RetentionTime'),'getAccessor') and callable(FLD('RetentionTime').getAccessor)) else (getattr(ar,'RetentionTime',u'') if (ar is not None and hasattr(ar,'RetentionTime')) else u'')) if ar else u'');
              retest_date      python:(S(ret_raw, u'') or FMTDT(date_respub_raw, '%Y.%m.%d', u'N/A'));
              contact_t        python:(T((ar.getContact() if (ar is not None and hasattr(ar,'getContact') and callable(ar.getContact)) else None), u'') if ar else u'');
              manufacturer     python:(contact_t or u'N/A');
              storage_obj      python:((FLD('StorageConditions').getRaw(ar) if (FLD('StorageConditions') is not None and hasattr(FLD('StorageConditions'),'getRaw') and callable(FLD('StorageConditions').getRaw)) else None) if ar else None);
              client_t         python:(T((ar.getClient() if (ar is not None and hasattr(ar,'getClient') and callable(ar.getClient)) else None), u'') if ar else u'');
              storage_cond     python:(((T(storage_obj, u'') or client_t) or u'N/A') if ar else u'N/A');
              cmt_raw          python:(((FLD('SafetyPrecautions').getAccessor(ar)() if (FLD('SafetyPrecautions') is not None and hasattr(FLD('SafetyPrecautions'),'getAccessor') and callable(FLD('SafetyPrecautions').getAccessor)) else (getattr(ar,'SafetyPrecautions',u'') if (ar is not None and hasattr(ar,'SafetyPrecautions')) else u'')) if ar else u''));
              remarks_raw      python:((ar.getRemarks() if (ar is not None and hasattr(ar,'getRemarks') and callable(ar.getRemarks)) else getattr(ar,'Remarks',u'')) if ar else u'');
              resremarks_raw   python:((ar.getResultsRemarks() if (ar is not None and hasattr(ar,'getResultsRemarks') and callable(ar.getResultsRemarks)) else getattr(ar,'ResultsRemarks',u'')) if ar else u'');
              comment          python:(u' / '.join([x for x in [S(cmt_raw, u''), S(remarks_raw, u''), S(resremarks_raw, u'')] if x]) or u'N/A');
              coa_ver_raw      python:((ar.getCoAVersion() if (ar is not None and hasattr(ar,'getCoAVersion') and callable(ar.getCoAVersion)) else None) if ar else None);
              coa_version      python:(S(coa_ver_raw) or u'V1.0');
              analyses         python:((ar.getAnalyses(full_objects=True) if (ar is not None and hasattr(ar,'getAnalyses') and callable(ar.getAnalyses)) else []) if ar else []);

              creator_id_raw   python:(((ar.Creator() if (ar is not None and hasattr(ar,'Creator') and callable(ar.Creator)) else getattr(ar,'Creator',u'')) or u'') if ar else u'');
              creator_id       python:S(creator_id_raw);
              creator_mem      python:(pm.getMemberById(creator_id) if (creator_id and pm is not None and hasattr(pm,'getMemberById') and callable(pm.getMemberById)) else None);
              creator_fn_raw   python:(creator_mem.getProperty('fullname') if (creator_mem is not None and hasattr(creator_mem,'getProperty') and callable(creator_mem.getProperty)) else u'');
              creator_fn       python:(S(creator_fn_raw) or u'admin');
              created_obj      python:(((ar.created() if (ar is not None and hasattr(ar,'created') and callable(ar.created)) else None) or getattr(ar,'creation_date', None)) if ar else None);
              created_date     python:FMTDT(created_obj, '%Y.%m.%d', u'');
              created_date_str python:S(created_date);
              report_suffix    python:(created_date_str.replace('.','').replace('-','')[:8] if created_date_str else u'');
              report_no        python:(u'COA-' + S(report_id) + u'-' + report_suffix);

              vids_per_a       python:[VG_NORM((a.getVerificators() if (hasattr(a,'getVerificators') and callable(a.getVerificators)) else [])) for a in analyses];
              vids_flat        python:[S(x) for sublist in vids_per_a for x in sublist if S(x)];
              vids_uniq        python:(list(set(vids_flat)) if vids_flat else []);
              vid0             python:(vids_uniq[0] if vids_uniq else u'');
              verifier_mem     python:(pm.getMemberById(vid0) if (vid0 and pm is not None and hasattr(pm,'getMemberById') and callable(pm.getMemberById)) else None);
              verifier_raw     python:(verifier_mem.getProperty('fullname') if (verifier_mem is not None and hasattr(verifier_mem,'getProperty') and callable(verifier_mem.getProperty)) else u'');
              verifier_name    python:S(verifier_raw);
              approver_name    python:u'';">

