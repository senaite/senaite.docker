<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone">

  <plone:static
      directory="templates"
      type="stickers"
      name="INNOCARE.LabelAndReport"
      />

  <!-- 库存标签适配器 -->
  <adapter
      factory=".adapters.StockBatchLabelTemplates"
      for="maitux.stock.interfaces.IStockBatches"
      />

  <!-- 样品标签适配器 -->
  <adapter
      factory=".adapters.SampleLabelTemplates"
      for="senaite.core.interfaces.ISamples"
      />

</configure>
