<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="INNOCARE.arextension">

  <adapter
      factory=".analysisrequest.ARSchemaExtender"
      provides="archetypes.schemaextender.interfaces.ISchemaExtender"
      name="INNOCARE.arextension.analysisrequest" />

  <adapter
      factory=".analysisrequest.ARSchemaModifier"
      provides="archetypes.schemaextender.interfaces.ISchemaModifier"
      name="INNOCARE.arextension.analysisrequest.modifier" />

</configure>
