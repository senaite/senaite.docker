import logging
log = logging.getLogger('INNOCARE.arextension.debug')

from bika.lims.browser.analysisrequest.add2 import AnalysisRequestManageView
_orig_get_ar_schema = AnalysisRequestManageView.get_ar_schema

def patched_get_ar_schema(self):
    schema = _orig_get_ar_schema(self)
    log.info('--- PATCHED GET AR SCHEMA ---')
    log.info('Fields: %s', schema.keys())
    return schema

AnalysisRequestManageView.get_ar_schema = patched_get_ar_schema
