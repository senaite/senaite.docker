<tal:sticker define="portal_state context/@@plone_portal_state;
                     portal_url portal_state/portal_url;
                     item python:view.current_item;
                     item_id item/getId;
                     batch_title python:(getattr(item, 'getBatchID', None) and item.getBatchID()) or
                                      (getattr(item, 'getTitle', None) and item.getTitle()) or
                                      (getattr(item, 'getId', None) and item.getId()) or '';">

  <div class="barcode"
       tal:attributes="data-id python:item_id;"
       data-code="code128"
       data-barHeight="14"
       data-addQuietZone="true"
       data-showHRI="false">
  </div>

  <div class="item-info">
    <table cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td colspan="2">
          <strong tal:content="batch_title">Batch ID</strong>
        </td>
      </tr>
    </table>
  </div>

</tal:sticker>
