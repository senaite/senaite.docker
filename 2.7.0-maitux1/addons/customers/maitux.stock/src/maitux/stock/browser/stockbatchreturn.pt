<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      i18n:domain="maitux.stock"
      metal:use-macro="context/main_template/macros/master">

  <metal:content fill-slot="content-core">
    <tal:block tal:define="batches python:view.get_batches();
                           errors python:request.get('return_errors', [])">
      <div class="mb-3">
        <h1 i18n:translate="">Return Stock Batches</h1>
      </div>

    <form method="post" tal:attributes="action string:${context/absolute_url}/@@stockbatch_return">
        <input tal:replace="structure context/@@authenticator/authenticator"/>
        <input type="hidden" name="uids" tal:attributes="value python:','.join(view.get_uids())" />

        <tal:block tal:condition="python:errors">
          <div class="alert alert-danger">
            <div tal:repeat="e errors" tal:content="python:e[1]">Error</div>
          </div>
        </tal:block>

        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th i18n:translate="">Batch ID</th>
              <th class="text-right" i18n:translate="">Current / Target / Unit</th>
              <th class="text-right" i18n:translate="">Max Return</th>
              <th class="text-right" i18n:translate="">Quantity</th>
              <th i18n:translate="">Remarks</th>
            </tr>
          </thead>
          <tbody>
            <tal:block tal:condition="python:not batches">
              <tr><td colspan="5" i18n:translate="">No items selected</td></tr>
            </tal:block>
            <tal:block tal:repeat="batch batches">
              <tal:block tal:define="info python:view.get_display_info(batch);
                                     uid python:info.get('uid')">
                <tr>
                  <td tal:content="python:info.get('batch_id') or info.get('title')">-</td>
                  <td class="text-right">
                    <span tal:replace="python:info.get('current_amount')">-</span>
                    <span>/</span>
                    <span tal:replace="python:info.get('target_quantity')">-</span>
                    <span>&nbsp;</span>
                    <span tal:replace="python:info.get('unit_title')">-</span>
                  </td>
                  <td class="text-right" tal:content="python:info.get('max_return')">-</td>
                  <td class="text-right">
                    <input type="number" step="0.01" min="0.01"
                           tal:attributes="name python:'qty.{}'.format(uid);
                                           value python:request.form.get('qty.{}'.format(uid), '')"
                           required="required"
                           class="form-control form-control-sm" />
                  </td>
                  <td>
                    <input type="text"
                           tal:attributes="name python:'remarks.{}'.format(uid);
                                           value python:request.form.get('remarks.{}'.format(uid), '')"
                           class="form-control form-control-sm" />
                  </td>
                </tr>
              </tal:block>
            </tal:block>
          </tbody>
        </table>

        <div class="mt-3">
          <a tal:attributes="href context/absolute_url"
             class="btn btn-outline-secondary" i18n:translate="">Cancel</a>
          <button type="submit" name="form.button.submit" class="btn btn-success" i18n:translate="">Return</button>
        </div>
      </form>
    </tal:block>
  </metal:content>
</html>
