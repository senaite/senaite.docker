<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">

  <metal:content fill-slot="content-core">
    <tal:block tal:define="src python:view.get_source();
                           info python:view.get_source_info();
                           candidates python:view.get_target_candidates();
                           locations python:view.get_locations();
                           errors python:request.get('split_errors', [])">
      <div class="mb-3">
        <h1>Split Stock Batch</h1>
      </div>

      <tal:block tal:condition="python:not src">
        <div class="alert alert-warning">No items selected</div>
      </tal:block>

      <tal:block tal:condition="python:src">
        <div class="card mb-3">
          <div class="card-body">
            <div><strong>Batch</strong>: <span tal:content="python:info.get('batch_id')">-</span></div>
            <div><strong>Stock</strong>: <span tal:content="python:info.get('stock_title')">-</span></div>
            <div><strong>Current</strong>: <span tal:content="python:info.get('current_amount')">-</span> <span tal:content="python:info.get('unit_title')">-</span></div>
            <div><strong>Status</strong>: <span tal:content="python:info.get('status')">-</span></div>
          </div>
        </div>

        <form method="post" tal:attributes="action string:${context/absolute_url}/@@stockbatch_split">
          <input tal:replace="structure context/@@authenticator/authenticator"/>
          <input type="hidden" name="uids" tal:attributes="value python:','.join(view.get_uids())" />

          <tal:block tal:condition="python:errors">
            <div class="alert alert-danger">
              <div tal:repeat="e errors" tal:content="python:e[1]">Error</div>
            </div>
          </tal:block>

          <div class="mb-3">
            <label class="mr-3">
              <input type="radio" name="mode" value="to_batch" checked="checked" />
              Create to batch
            </label>
            <label>
              <input type="radio" name="mode" value="new_batch" />
              Add new batch
            </label>
          </div>

          <div class="mb-3">
            <label>Target batch</label>
            <select name="target_batch_uid" id="target-batch-select" class="form-control form-control-sm">
              <option value=""></option>
              <tal:block tal:repeat="c candidates">
                <option tal:attributes="value python:c.get('uid')"
                        tal:content="python:u'{} (Current: {})'.format(c.get('title'), c.get('current_amount'))">-</option>
              </tal:block>
            </select>
            <small class="form-text text-muted" tal:condition="python:not candidates">No eligible target batch found (same stock and not expired or destroyed).</small>
          </div>

          <div class="mb-3">
            <label>Location (for new batch)</label>
            <select name="location_uid" id="location-select" class="form-control form-control-sm">
              <option value=""></option>
              <tal:block tal:repeat="l locations">
                <option tal:attributes="value python:l.get('uid')"
                        tal:content="python:l.get('title')">-</option>
              </tal:block>
            </select>
          </div>

          <div class="mb-3">
            <label>Quantity</label>
            <input type="number" step="0.01" min="0.01" name="quantity"
                   tal:attributes="value python:request.form.get('quantity','')"
                   required="required"
                   class="form-control form-control-sm" />
          </div>

          <div class="mb-3">
            <label>Remarks</label>
            <input type="text" name="remarks"
                   tal:attributes="value python:request.form.get('remarks','')"
                   class="form-control form-control-sm" />
          </div>

          <div class="mt-3">
            <a tal:attributes="href context/absolute_url"
               class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" name="form.button.submit" class="btn btn-primary">Save</button>
          </div>
        </form>

        <script type="text/javascript">
        (function () {
          function byName(name) { return document.querySelector('[name="' + name + '"]'); }
          function toggleTargets() {
            var modeToBatch = document.querySelector('input[name="mode"][value="to_batch"]');
            var toBatch = modeToBatch && modeToBatch.checked;
            var tgt = document.getElementById("target-batch-select");
            var loc = document.getElementById("location-select");
            if (tgt) {
              tgt.disabled = !toBatch;
              tgt.closest(".mb-3").style.opacity = toBatch ? 1 : 0.5;
            }
            if (loc) {
              loc.disabled = toBatch;
              loc.closest(".mb-3").style.opacity = toBatch ? 0.5 : 1;
            }
          }
          function init() {
            var radios = document.querySelectorAll('input[name="mode"]');
            for (var i = 0; i < radios.length; i++) {
              radios[i].addEventListener("change", toggleTargets);
            }
            var candidates = document.querySelectorAll('#target-batch-select option[value]');
            if (document.getElementById("target-batch-select") && candidates.length <= 1) {
              var r = document.querySelector('input[name="mode"][value="new_batch"]');
              if (r) r.checked = true;
            }
            toggleTargets();
          }
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
          } else {
            init();
          }
        })();
        </script>
      </tal:block>
    </tal:block>
  </metal:content>
</html>
