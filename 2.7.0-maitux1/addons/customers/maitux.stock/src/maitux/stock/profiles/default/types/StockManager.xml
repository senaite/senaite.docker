<?xml version="1.0" encoding="UTF-8"?>
<object name="StockManager" meta_type="Dexterity FTI"
        i18n:domain="maitux.stock"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        purge="True">

  <property name="title" i18n:translate="">Stockinventory</property>
  <property name="description" i18n:translate="">Stock management</property>

  <property name="icon_expr">string:${portal_url}/++plone++senaite.core.static/assets/icons/setup.svg</property>
  <property name="factory">StockManager</property>
  <property name="add_view_expr">string:${folder_url}/++add++StockManager</property>

  <property name="global_allow">False</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="StockSection" />
    <element value="LowStockSection" />
    <element value="StockFolder" />
    <element value="StockUnits" />
    <element value="StockTypes" />
    <element value="StockPurchaseOrders" />
    <element value="StockBatches" />
  </property>

  <property name="allow_discussion">False</property>
  <property name="default_view">stock_dashboard</property>
  <property name="view_methods">
    <element value="view"/>
    <element value="stock_dashboard"/>
  </property>
  <property name="default_view_fallback">False</property>

  <property name="schema">maitux.stock.content.stockmanager.IStockManagerSchema</property>
  <property name="klass">maitux.stock.content.stockmanager.StockManager</property>

  <property name="behaviors">
    <element value="plone.app.dexterity.behaviors.metadata.IBasic"/>
    <element value="plone.app.referenceablebehavior.referenceable.IReferenceable" />
  </property>

  <alias from="(Default)" to="(dynamic view)"/>
  <alias from="edit" to="@@edit"/>
  <alias from="sharing" to="@@sharing"/>
  <alias from="view" to="(selected layout)"/>

  <action title="View"
          action_id="view"
          category="object"
          condition_expr=""
          description=""
          icon_expr=""
          link_target=""
          url_expr="string:${object_url}"
          visible="True">
    <permission value="View"/>
  </action>

  <action title="Edit"
          action_id="edit"
          category="object"
          condition_expr=""
          description=""
          icon_expr=""
          link_target=""
          url_expr="string:${object_url}/edit"
          visible="True">
    <permission value="Modify portal content"/>
  </action>

</object>

