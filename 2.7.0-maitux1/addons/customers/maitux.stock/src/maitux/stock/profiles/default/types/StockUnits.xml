<?xml version="1.0" encoding="UTF-8"?>
<object name="StockUnits" meta_type="Dexterity FTI"
        i18n:domain="maitux.stock"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        purge="True">

  <property name="title" i18n:translate="">Units</property>
  <property name="description" i18n:translate=""></property>

  <property name="icon_expr">string:${portal_url}/++plone++senaite.core.static/assets/icons/clientfolder.svg</property>
  <property name="factory">StockUnits</property>
  <property name="add_view_expr">string:${folder_url}/++add++StockUnits</property>
  <property name="immediate_view">stock_units</property>

  <property name="global_allow">False</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="StockUnit" />
  </property>

  <property name="allow_discussion">False</property>
  <property name="default_view">stock_units</property>
  <property name="view_methods">
    <element value="stock_units"/>
    <element value="folder_view"/>
  </property>
  <property name="default_view_fallback">False</property>

  <property name="add_permission">cmf.AddPortalContent</property>

  <property name="schema">maitux.stock.content.stockunits.IStockUnitsSchema</property>
  <property name="klass">maitux.stock.content.stockunits.StockUnits</property>

  <property name="behaviors">
    <element value="plone.app.dexterity.behaviors.metadata.IBasic"/>
    <element value="plone.app.referenceablebehavior.referenceable.IReferenceable" />
  </property>

  <alias from="(Default)" to="(dynamic view)"/>
  <alias from="edit" to="@@edit"/>
  <alias from="sharing" to="@@sharing"/>
  <alias from="view" to="(selected layout)"/>

</object>

