<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="maitux.stability">
  <body>
    <metal:content fill-slot="content-core">
      <h1 i18n:translate="">Link Existing Sample</h1>

      <form method="post"
            tal:attributes="action string:${context/absolute_url}/@@link_sample">
        <input tal:replace="structure context/@@authenticator/authenticator"/>
        <tal:block tal:repeat="item python:view.tasks">
          <input type="hidden" name="row_ids:list" tal:attributes="value item/row_id"/>
        </tal:block>

        <div class="alert alert-info" tal:condition="python:not view.tasks">
          <span i18n:translate="">No plan details selected.</span>
        </div>

        <table class="table table-sm table-striped" tal:condition="python:bool(view.tasks)">
          <thead>
            <tr>
              <th i18n:translate="">Plan</th>
              <th i18n:translate="">Task</th>
              <th i18n:translate="">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="item python:view.tasks">
              <td><a tal:attributes="href item/plan_url" tal:content="item/plan_title">Plan</a></td>
              <td tal:content="item/task_title">Task</td>
              <td tal:content="item/status">Status</td>
            </tr>
          </tbody>
        </table>

        <div class="form-group" tal:condition="python:bool(view.tasks)">
          <label for="sample_uid" i18n:translate="">Select Sample</label>
          <select id="sample_uid" name="sample_uid" class="form-control form-control-sm" required="required">
            <option value="" i18n:translate="">Select鈥?/option>
            <option tal:repeat="s python:view.recent_samples"
                    tal:attributes="value s/uid"
                    tal:content="s/title">SAMPLE-1</option>
          </select>
          <small class="form-text text-muted" i18n:translate="">
            鍙垪鍑烘渶杩戠殑鏍峰搧锛屽悗缁彲浠ュ姞鎼滅储妗?寮圭獥閫夋嫨銆?          </small>
        </div>

        <div class="mt-3" tal:condition="python:bool(view.tasks)">
          <button type="submit" name="button_save" value="1" class="btn btn-primary btn-sm" i18n:translate="">Save</button>
          <button type="submit" name="button_cancel" value="1" class="btn btn-secondary btn-sm" i18n:translate="">Cancel</button>
        </div>
      </form>
    </metal:content>
  </body>
</html>

