<?xml version="1.0" encoding="UTF-8"?>
<object name="PackagingSpecifications" meta_type="Dexterity FTI"
        i18n:domain="maitux.stability"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n">

  <property name="title"
            i18n:translate="">Packaging Specifications</property>
  <property name="description"
            i18n:translate="">Static table for stability packaging specifications.</property>

  <property name="icon_expr">string:${portal_url}/++plone++senaite.core.static/assets/icons/clientfolder.svg</property>
  <property name="factory">PackagingSpecifications</property>
  <property name="add_view_expr">string:${folder_url}/++add++PackagingSpecifications</property>

  <property name="link_target"/>
  <property name="immediate_view">view</property>

  <property name="global_allow">False</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="PackagingSpecification" />
  </property>

  <property name="allow_discussion">False</property>
  <property name="default_view">view</property>
  <property name="view_methods">
    <element value="view"/>
  </property>
  <property name="default_view_fallback">False</property>

  <property name="add_permission">cmf.AddPortalContent</property>

  <property name="schema">maitux.stability.content.packagingspecifications.IPackagingSpecificationsSchema</property>
  <property name="klass">maitux.stability.content.packagingspecifications.PackagingSpecifications</property>

  <property name="behaviors">
    <element value="plone.app.dexterity.behaviors.metadata.IBasic"/>
    <element value="plone.app.referenceablebehavior.referenceable.IReferenceable" />
  </property>

  <alias from="(Default)" to="(dynamic view)"/>
  <alias from="edit" to="@@edit"/>
  <alias from="sharing" to="@@sharing"/>
  <alias from="view" to="(selected layout)"/>

</object>

