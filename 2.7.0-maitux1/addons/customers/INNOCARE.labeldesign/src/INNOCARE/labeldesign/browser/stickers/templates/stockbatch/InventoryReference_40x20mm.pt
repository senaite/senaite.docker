<tal:sticker define="item python:view.current_item;
                     stock_type python:(getattr(item, 'stock', None) and getattr(item.stock, 'number', None)) or '';
                     batch_id python:(getattr(item, 'getBatchID', None) and item.getBatchID()) or (getattr(item, 'getId', None) and item.getId()) or '';
                     mfr python:(getattr(item, 'stock', None) and getattr(item.stock, 'supplier', None)) and ', '.join([x.get('title', '') for x in getattr(item.stock.supplier, 'getObject', lambda: [])()] or []) or '';">
  <div class="label inv-reference">
    <div class="label-header inv-reference">
      <span class="label-title">对照品标签</span>
      <span class="material-name" tal:content="python:getattr(item.stock, 'sample_matrix', None) and getattr(item.stock.sample_matrix, 'Title', lambda: '')() or ''">材料名称</span>
    </div>

    <table class="label-table" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="lbl-label">库存编号</td>
        <td class="lbl-value" tal:content="stock_type">12345</td>
      </tr>
      <tr>
        <td class="lbl-label">物料名称</td>
        <td class="lbl-value" tal:content="python:getattr(item.stock, 'sample_matrix', None) and getattr(item.stock.sample_matrix, 'Title', lambda: '')() or ''">材料名称</td>
      </tr>
      <tr>
        <td class="lbl-label">厂家批号</td>
        <td class="lbl-value" tal:content="python:getattr(item, 'batch', '') or ''">BATCH-01</td>
      </tr>
      <tr>
        <td class="lbl-label">生产厂家</td>
        <td class="lbl-value" tal:content="mfr">生产厂家</td>
      </tr>
      <tr>
        <td class="lbl-label">复检期</td>
        <td class="lbl-value" tal:content="python:(getattr(item, 'expiry_date', None) and item.expiry_date.strftime('%Y-%m-%d')) or ''">2026-08-24</td>
      </tr>
      <tr>
        <td class="lbl-label">存储位置</td>
        <td class="lbl-value" tal:content="python:getattr(item.location, 'Title', lambda: '')() if getattr(item, 'location', None) else ''">A-01</td>
      </tr>
      <tr>
        <td class="lbl-label">储存条件</td>
        <td class="lbl-value" tal:content="python:getattr(item, 'storage_condition', '') or ''">2-8°C</td>
      </tr>
      <tr>
        <td class="lbl-label">含量/纯度</td>
        <td class="lbl-value" tal:content="python:getattr(item, 'strength', '') or ''">99.5%</td>
      </tr>
    </table>

    <div class="code-row">
      <div class="barcode"
           tal:attributes="data-id python:batch_id;"
           data-code="code128"
           data-barHeight="8"
           data-addQuietZone="true"
           data-showHRI="false">
      </div>
      <div class="qrcode"
           data-size="48"
           data-render="image"
           data-quiet="2"
           tal:attributes="data-text python:batch_id">
      </div>
    </div>
  </div>
</tal:sticker>