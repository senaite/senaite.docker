<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone">

  <!-- 注册库存标签模板适配器（覆盖 maitux.stock 的同名适配器）。
       for 用容器接口 IStockBatches（与 stockbatch_print 打印入口一致），
       使 stockbatch_print 能枚举并选用本 addon 的库存标签模板。
       必须放在 overrides.zcml：maitux.stock 已注册同名适配器，
       在 configure.zcml 中注册会触发 ConfigurationConflictError。 -->
  <adapter
      factory="INNOCARE.labeldesign.browser.stickers.adapters.StockBatchLabelTemplates"
      for="maitux.stock.interfaces.IStockBatches"
      provides="senaite.core.interfaces.stickers.IGetStickerTemplates"
      />

  <!-- 样品标签模板适配器：/lims/samples/sticker（senaite.core StickerView，
       context 为 Samples 容器，实现 ISamples）通过该适配器枚举并默认选用
        本 addon 的样品标签模板（见 adapters.py 注释）。 -->
  <adapter
      factory="INNOCARE.labeldesign.browser.stickers.adapters.SampleLabelTemplates"
      for="senaite.core.interfaces.ISamples"
      provides="senaite.core.interfaces.stickers.IGetStickerTemplates"
      />

</configure>
