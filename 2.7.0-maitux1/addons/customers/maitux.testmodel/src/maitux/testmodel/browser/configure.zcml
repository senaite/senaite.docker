<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="maitux.testmodel">

  <!-- 容器仪表盘视图 -->
  <browser:page
      for="maitux.testmodel.interfaces.ITestmodelContainer"
      name="dashboard"
      class="maitux.testmodel.browser.dashboard.TestmodelDashboard"
      template="dashboard.pt"
      permission="zope2.View"
      />

  <!-- 新增更多视图时，在此添加 <browser:page> 块 -->

</configure>
