<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="maitux.hazardcategories">

  <class class=".hazardcategories.HazardCategories">
    <require
        permission="zope2.View"
        interface="zope.interface.Interface"
        />
  </class>

  <class class=".hazardcategory.HazardCategory">
    <require
        permission="zope2.View"
        interface="maitux.hazardcategories.interfaces.IHazardCategory"
        />
  </class>

  <adapter
      name="usage_scope"
      factory=".hazardcategory.usage_scope"
      for="maitux.hazardcategories.interfaces.IHazardCategory
           senaite.core.interfaces.ISetupCatalog"
      provides="plone.indexer.interfaces.IIndexer" />

  <adapter
      name="allowedRolesAndUsers"
      factory=".hazardcategory.allowed_roles_and_users"
      for="maitux.hazardcategories.interfaces.IHazardCategory
           senaite.core.interfaces.ISetupCatalog"
      provides="plone.indexer.interfaces.IIndexer" />

</configure>
