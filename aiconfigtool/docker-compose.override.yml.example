# ============================================================
#  可选：接入本机 Senaite 的 Docker 网络，用容器名访问本机站点
#
#  为什么需要：本机 Senaite 现在固定用 80/443，而这两个端口由 Senaite 的 nginx
#  容器发布。实测从本工具容器经 host.docker.internal 访问 80/443 会失败
#  （80 拿到 Docker Desktop 合成的空 502、443 是 TLS EOF，请求根本没到 Senaite
#  的 nginx——其 access.log 里查不到）。接入同一 Docker 网络后用容器名访问是
#  实测可用的方式（返回 200）。
#
#  compose 会自动合并同目录下的 docker-compose.override.yml，
#  所以基础 docker-compose.yml 保持零外部依赖，不影响「本机没有 Senaite」的场景。
#
#  用法：
#    1) cp docker-compose.override.yml.example docker-compose.override.yml
#    2) 查出实际网络名，替换下面的 name：
#         docker inspect maitux-lims-nginx --format "{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}"
#    3) docker compose up -d
#    4) 把 data/sites/*/config.json 里本机站点的地址改成容器名，例如
#         https://localhost/lims  →  https://maitux-lims-nginx/lims
#         connection.baseUrl      →  https://maitux-lims-nginx
#       用「直接安装」的话，connection.containerName 填 Zope 实例容器名（如 maitux-lims），
#       不要留空——自动探测按端口匹配会命中发布了 80/443 的 nginx 容器，buildout 必失败。
#
#  ⚠ external 表示该网络不由本 compose 创建，所以 Senaite 那套必须先启动，
#    否则 up 会报 network not found。不需要时删掉 docker-compose.override.yml
#    即可回到零依赖状态。
# ============================================================

services:
  app:
    networks:
      # 显式列出 default：一旦声明 networks，服务就不再自动加入默认网络
      - default
      - senaite

networks:
  senaite:
    external: true
    # 改成你实际在跑的那套（项目名 + "_" + 网络名）
    name: 270-maitux1_maitux_lims_backend
