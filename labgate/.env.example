# ============================================================
#  labgate compose 配置模板
#
#    cp .env.example .env       然后按现场实际值改
#    docker compose up -d
#
#  .env 里是每台机器/每个实验室各不相同的值，尤其是令牌，
#  已在 .gitignore 中排除，不要提交。本模板里只能放占位值。
#
#  现场部署（拉镜像 / 离线导入 / 排错）见 部署说明.md，实施人员不需要编译。
# ============================================================

# ── 镜像 ────────────────────────────────────────────────────
# 镜像标签，同时用于 make docker-build / make docker-push
LABGATE_VERSION=dev

# ── 网关自身 ────────────────────────────────────────────────
# 管理界面登录账号。密码留空 = 不启用登录（谁都能打开 8090，只建议内网调试用）
LABGATE_ADMIN_USER=admin
LABGATE_ADMIN_PASSWORD=change-me
# 站点标识，一个实验室一个
LABGATE_SITE_ID=lab-main
# auto = 主动轮询 LIMS 拿采集指令
LABGATE_MODE=auto
# 管理界面对宿主机发布的端口（LIMS 的 agent_api_url 填 宿主机IP:此端口）
LABGATE_PORT=8090
# 可选：管理接口鉴权令牌，留空则不鉴权。
# 设置后界面请求需带 Authorization: Bearer <token>（配置页可「记住到本机」）
LABGATE_API_TOKEN=

# ── 对接 LIMS ───────────────────────────────────────────────
# 真 LIMS 地址（Linux 服务器）
LABGATE_LIMS_URL=http://192.168.1.18:8081/lims
# LIMS 中转站模板上登记的 agent_token，一个中转站一个 —— 换成现场实际值
LABGATE_LIMS_TOKEN=change-me
# 轮询 LIMS 拿采集指令（auto 模式）
LABGATE_LIMS_POLL=true
# 读数 HTTP 直推 LIMS ingest 接口
LABGATE_LIMS_PUSH=true

# ── 局域网 / 其它 ───────────────────────────────────────────
# 容器内访问宿主局域网 IP：让 labgate 连本机上的天平/串口网关
LABGATE_HOST_LAN_IP=192.168.1.5
TZ=Asia/Shanghai
